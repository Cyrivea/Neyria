# Neyria backend example configuration (copy to .env and fill real values)
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret

# Chat and lyrics generation: the frontend never receives these values.
# LLM_PROVIDER=zhipu 走智谱 SDK（默认）；=openai 走 Kunbot 网关（ant.kunbot.org，OpenAI 兼容聚合）。
# 切 openai 时 CHAT_MODEL 传路由上按 /v1/models 查到的当前模型 ID（传错会被自动落到清单首项）。
API_KEY=replace-with-zhipu-api-key
LYRICS_MODEL=glm-4-flash

# Kunbot gateway（文字+生图路由；该站暂无视频路由，视频仍走 SiliconFlow Wan2.2）
LLM_PROVIDER=zhipu
KUNBOT_API_KEY=replace-with-kunbot-api-key
KUNBOT_CHAT_BASE=https://anthropic.kunbot.org/uni/v1
IMAGE_PROVIDER=siliconflow
KUNBOT_IMAGE_BASE=https://anthropic.kunbot.org/7sref/v1
IMAGE_MODEL_KUNBOT=gpt-image-2

# RAG（不随文本/生图切换——embedding 处理器仍走 SiliconFlow bge-m3）
SILICONFLOW_API_KEY=replace-with-siliconflow-api-key
EMBEDDING_MODEL=BAAI/bge-m3

# Runtime dependencies
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
